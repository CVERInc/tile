# build scratch
out/
.DS_Store
*.bak
__pycache__/

# node
node_modules/

# @tile/cssmd has no dependencies, so its lockfile records nothing — it is a by-product of running
# npm in that directory. Ignored by path rather than by pattern: a package that grows a real
# dependency should still commit a real lockfile.
/packages/cssmd/package-lock.json

# scripts/commonmark-score.mjs downloads the spec here. Not committed: the spec is CC-BY-SA and this
# repo is MIT, and vendoring it is the owner's call, not a side effect of running a score.
.cache/

# transient publish payloads (scripts/publish*.sh assemble into a dest dir you pass in;
# never commit those staged payloads back into this repo)
/pub-*/
/tmp-*/

# astro build scratch — sitetile's renderer and its smoke.
# dist-smoke/ is the smoke's ISOLATED output (never dist/, which is the shared build berth a real
# site build writes to); .astro/ is the framework's own cache.
packages/sitetile/astro/dist-smoke/
packages/sitetile/astro/dist/
packages/sitetile/astro/.astro/
# the smoke's SECOND, isolated build — a throwaway rsync'd copy of astro/ with its own hostile
# content/blog fixture (site-level fields a single-page fixture can't exercise; see
# smoke-build.mjs's buildHostileBlogFixture for why). Rebuilt every smoke run, never committed.
packages/sitetile/.smoke-hostile-blog/
# the smoke's THIRD, isolated build — same content/src as the primary build, just a different
# PLATFORM_ORIGIN (Inbox transport regression coverage; see smoke-build.mjs's own comment above
# this build for why it must be a SIBLING of dist-smoke/, never nested inside it). Rebuilt every
# smoke run, never committed.
packages/sitetile/.smoke-nonprod-origin/
# @tile/build stashes the renderer's own content/, blog/, pagetile/ and public/ HERE while it builds
# somebody's site, and moves them back afterwards — including when the build throws. The directory
# should never outlive a build; it is ignored because the one time it does (a killed process) the
# next thing that must not happen is `git add -A` committing a copy of the renderer into the
# renderer, or a site's staged pages into this repo.
packages/sitetile/astro/.tile-build-stash-*
# …and the one-build-at-a-time lock beside it. Same reason: it should never outlive a build, and the
# one time it does it must not be committed into the repo as a permanent "someone is building".
packages/sitetile/astro/.tile-build-lock
# 🔴 THE WALL. `lab/` is the incubator's never-graduates folder — creators' cards, our deployment
# config, the forbidden-terms list. It lives in CVERInc/tile-lab, which has this repo as a
# submodule at engine/. Ignoring it here means a careless copy in the wrong direction cannot commit
# somebody's card into the public repo. Naming alone was a habit; this is a wall. (2026-08-13)
lab/

# A local `node packages/dynamic-corals/build.mjs` publishes into this path by default. The real
# registry is a DEPLOYMENT's — passed with --registry, and living in the repo that owns the deploy.
# What lands here is scratch, and committing it would be committing somebody else's serving data.
/packages/dynamic-corals/registry/versions/

# 🩸 wrangler's local state. It was NOT here until 2026-09-07, and the incubator ignored it — so
# `cp -R packages/cardtile` carried `serve/.wrangler/state/v3/kv/<real namespace id>/blobs/…` into
# this repo, containing a CUSTOMER'S CARD, and `git add -A` staged it without comment. The
# publish-safety scan is what found it, on the namespace id in the path.
#
# 🔴 The lesson is not "remember to delete it". It is that an ignore rule is part of the wall, and
# a file crossing between two repos is only as protected as the WEAKER of their two ignore lists.
.wrangler/
