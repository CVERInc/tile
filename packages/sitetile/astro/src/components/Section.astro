---
// Dispatch one parsed section to its layout component by type. Unknown types fall back to prose
// (matching the reference renderer's KNOWN_TYPES guard); the literal type token still round-trips.
import Hero from './sections/Hero.astro';
import Prose from './sections/Prose.astro';
import Grid from './sections/Grid.astro';
import Gallery from './sections/Gallery.astro';
import Carousel from './sections/Carousel.astro';
import Cta from './sections/Cta.astro';
import Embed from './sections/Embed.astro';
import Collection from './sections/Collection.astro';
import Timeline from './sections/Timeline.astro';
import Social from './sections/Social.astro';
import Tagcloud from './sections/Tagcloud.astro';
import Faq from './sections/Faq.astro';
import Form from './sections/Form.astro';
import People from './sections/People.astro';

const { section, index = 0, lang, blogPosts = [], meta = {} } = Astro.props;
const MAP = { hero: Hero, prose: Prose, grid: Grid, gallery: Gallery, carousel: Carousel, cta: Cta, embed: Embed, collection: Collection, timeline: Timeline, social: Social, tagcloud: Tagcloud, faq: Faq, form: Form, people: People };
const Cmp = MAP[section.type] || Prose;
// The page's FIRST section carries its primary heading → render it as <h1> (one per page,
// semantic/SEO), the rest stay <h2>. Components opt in by honouring the `hero` prop.
const hero = index === 0;
---
<Cmp section={section} hero={hero} lang={lang} blogPosts={blogPosts} meta={meta} />
