---
// `people` coral — a roster of humans (or the companies they stand for): portrait, name, the roles
// they hold, what they do, where to find them. Mirrors the reference renderSection 'people' case so
// the editor live-preview matches the Astro build byte-for-byte.
//
// Depth is inferred at parse time: a flat roster arrives as ONE untitled group and renders without
// the group wrapper; a grouped roster renders a labelled block per group. Theme paints
// `.st-people` / `.st-person` / `.st-person-role`; site.css carries the structural defaults so a
// roster is legible on a site that has never been themed.
// The markup is packages/emit/people.mjs (tile-lab#52); this component reads the params and hands
// their values over.
import { parseParams } from '@sitetile';
import { emitPeople } from '@emit/people.mjs';
const { section, hero } = Astro.props;
// The page's FIRST section carries its primary heading as <h1> — the same seam Prose/Faq/
// Timeline already honour. A roster that opened a page rendered <h2> and the page had NO h1:
// bad for the document outline, and the theme's title band attaches to h1, so those pages
// silently lost their band too. (emitPeople picks the tag from `hero`.)
const pm = parseParams(section.params);
const eyebrow = pm.eyebrow ? (typeof pm.eyebrow === 'object' ? pm.eyebrow.label : pm.eyebrow) : null;
const shape = pm.shape === 'logo' ? 'logo' : 'avatar';
---
<Fragment set:html={emitPeople(section, { eyebrow, cols: pm.cols, shape }, { hero })} />
