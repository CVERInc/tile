---
// `people` coral — a roster of humans (or the companies they stand for): portrait, name, the roles
// they hold, what they do, where to find them. Mirrors the reference renderSection 'people' case so
// the editor live-preview matches the Astro build byte-for-byte.
//
// Depth is inferred at parse time: a flat roster arrives as ONE untitled group and renders without
// the group wrapper; a grouped roster renders a labelled block per group. Theme paints
// `.st-people` / `.st-person` / `.st-person-role`; site.css carries the structural defaults so a
// roster is legible on a site that has never been themed.
import { parseParams, inlineHtml, bodyHtml, firstImage, imgTag, slugify } from '@sitetile';
const { section } = Astro.props;
const pm = parseParams(section.params);
const eyebrow = pm.eyebrow ? (typeof pm.eyebrow === 'object' ? pm.eyebrow.label : pm.eyebrow) : null;
const shape = pm.shape === 'logo' ? 'logo' : 'avatar';
const groups = section.groups || [];
const flat = groups.length === 1 && !groups[0].title;
const gid = (t) => 'people-' + slugify(t, 'g');
const roles = (b) => String(b || '').split('·').map((x) => x.trim()).filter(Boolean);
const ext = (h) => /^https?:\/\//.test(h);
---
<section class="st-people" data-cols={pm.cols || ''} data-shape={shape}>
  {eyebrow && <p class="st-people-eyebrow" set:html={inlineHtml(eyebrow)} />}
  {section.title && <h2 set:html={inlineHtml(section.title)} />}
  {section.body && <Fragment set:html={bodyHtml(section.body)} />}
  {groups.map((g) => {
    const cells = (
      <div class="st-people-cells">
        {(g.people || []).map((p) => {
          const fi = firstImage(p.body);
          return (
            <div class="st-person" data-tone={p.tone || undefined}>
              {fi.img && <Fragment set:html={`<figure class="st-person-fig">${imgTag(fi.img.alt, fi.img.src)}</figure>`} />}
              <h3 class="st-person-name">
                {p.href
                  ? <a href={p.href} target={ext(p.href) ? '_blank' : undefined} rel={ext(p.href) ? 'noopener' : undefined} set:html={inlineHtml(p.title)} />
                  : <Fragment set:html={inlineHtml(p.title)} />}
              </h3>
              {p.badge && (
                <span class="st-person-roles">
                  {roles(p.badge).map((x) => <span class="st-person-role">{x}</span>)}
                </span>
              )}
              <div class="st-person-body" set:html={bodyHtml(fi.rest)} />
              {p.links && p.links.length > 0 && (
                <div class="st-person-links">
                  {p.links.map((l) => (
                    <a class="st-person-link" href={l.href} target={ext(l.href) ? '_blank' : undefined} rel={ext(l.href) ? 'noopener' : undefined}>{l.label}</a>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>
    );
    return flat ? cells : (
      <div class="st-people-group">
        <p class="st-people-group-head" id={gid(g.title)} set:html={inlineHtml(g.title)} />
        {g.lead && <Fragment set:html={bodyHtml(g.lead)} />}
        {cells}
      </div>
    );
  })}
</section>
