---
// The markup is packages/emit/hero.mjs (tile-lab#52); this component reads the params and hands
// their values over, with sitetile's own markdown renderers.
import { parseParams, inlineHtml, bodyHtml, safeSrc } from '@sitetile';
import { emitHero } from '@emit/hero.mjs';
const { section } = Astro.props;
const pm = parseParams(section.params);
// round 4: `bg=` is an author-controlled background-image destination reaching a live CSS
// `url()` with no gate — the same sink class as `logo=`/`layers=` below, gated the same way
// (`safeSrc`, since this is an image destination). A disallowed scheme drops the background
// entirely rather than reaching `url(javascript:…)`/`url(data:text/html,…)`.
// round 5 (R4-P3-6): a SAFE destination still isn't a SAFE `url()` token — an unquoted `url()`
// has no way to escape `)`/`;`, so `/a.png);position:fixed;…` closed the declaration and opened
// arbitrary new ones in this element's own inline style (a defacement/clickjacking primitive,
// no script involved). `cssUrlString` quotes it and CSS-escapes exactly the two characters a
// quoted CSS string treats specially; Astro's own attribute escaping (which the report measured
// does escape `"`/`&`, only not `>`) still runs on top and is unaffected — the browser decodes
// HTML entities in the attribute value before the CSS parser ever sees it, so the quotes/escapes
// built here survive to the CSS parser intact.
const bgOk = pm.bg ? safeSrc(pm.bg) : null;
// (emitHero turns bgOk into the quoted `style` with cssUrlString.)
const media = pm.media === 'logo' ? 'logo' : 'avatar';   // foreground image variant (round avatar vs uncropped logo)
// `layout` (e.g. split) = OPT-IN columned hero (eyebrow + lead + button row + side art). Absent →
// the legacy hero (h1 + body + single `cta=`), kept byte-identical so an existing logo hero is untouched.
// `layout=bubble` — OPT-IN speech-bubble hero (Card family, a reusable asset — not a one-site hack):
// same eyebrow/h1/body/CTA content and the same `heroParts` body conventions as `split` (lead prose +
// one links-only paragraph → CTA button row + one standalone image → art below), just wrapped in a
// `.st-hero-bubble` card instead of a plain `.st-hero-text` column. The theme draws the card chrome
// (white rounded card, downward tail, solid button) off `[data-layout="bubble"]`; the only DOM change
// here is which wrapper class the shared text block gets, so any future site/page can opt in the same
// way `layout=split` does, with zero new markup to learn. Params: `layout=bubble` (required to opt
// in), `eyebrow="…"` (optional, same as split), CTA via a links-only paragraph in the body (or the
// legacy `cta=` param, same fallback as split).
const layout = pm.layout ? (typeof pm.layout === 'object' ? pm.layout.label : pm.layout) : null;
const eyebrow = pm.eyebrow ? (typeof pm.eyebrow === 'object' ? pm.eyebrow.label : pm.eyebrow) : null;
// `marquee="A|B|C"` — OPT-IN animated background word-marquee: one horizontally-scrolling row per
// pipe-separated word, faint behind the hero content, alternating direction. General decorative
// treatment (theme sets colour/size). Each row repeats its word enough to loop seamlessly.
const marqueeRaw = pm.marquee ? (typeof pm.marquee === 'object' ? pm.marquee.label : pm.marquee) : null;
const marqueeWords = marqueeRaw ? String(marqueeRaw).split('|').map((w) => w.trim()).filter(Boolean) : [];
// `enter` (bare flag) — OPT-IN entrance treatment: renders the `bg=` image as a separate
// absolutely-positioned layer the theme can scale/fade on load (a ken-burns settle), and marks
// the section `data-enter` so the theme can stagger the heading/lead/CTA in. General; absent →
// the section keeps its plain CSS background and no animation (a non-opted site is unaffected).
const enter = pm.enter != null;
// `layers=back.webp|front.webp` (back-to-front, pipe-separated) + `parallax` (bare flag) — OPT-IN
// multi-layer depth hero: each image is an absolutely-stacked layer the client script drifts at a
// depth-scaled rate on pointer-move + scroll (front moves more). `logo=/logo.png` renders the h1 as
// an image (its text stays the alt → SEO/AX intact); `logo-pos=top|center|bottom` (default bottom)
// places the title block over the art's negative space. General; absent → the legacy heroes above.
const layersRaw = pm.layers ? (typeof pm.layers === 'object' ? pm.layers.label : pm.layers) : null;
const layerList = layersRaw ? String(layersRaw).split('|').map((s) => s.trim()).filter(Boolean) : [];
const parallax = pm.parallax != null;
const logoRaw = pm.logo ? (typeof pm.logo === 'object' ? (pm.logo.href || pm.logo.label) : String(pm.logo)) : null;
// round 3 (Astro consumers, R2-P3-5): `logo=`/`layers=` params and `heroParts`' extracted image
// are all author-controlled `src` destinations that reach a live `<img>` — site-core.js's own
// `imgTag` gates every image src on `isSafeImageSrc`; `safeSrc` shares that ONE policy (here for
// `logo=`, in emitHero for each layer and each extracted image). `null` degrades to no image.
const logo = logoRaw ? safeSrc(logoRaw) : null;
const logoPos = pm['logo-pos'] ? String(typeof pm['logo-pos'] === 'object' ? pm['logo-pos'].label : pm['logo-pos']) : 'bottom';
---
<Fragment set:html={emitHero(section, { media, layout, eyebrow, marqueeWords, enter, layerList, parallax, logo, logoPos, cta: pm.cta, bgOk }, { inline: inlineHtml, block: bodyHtml })} />

<script>import '../../../../../dynamic-corals/hero-parallax/hero-parallax-client.mjs';</script>
