---
// Escape hatch: body is passed through VERBATIM (no markdown processing) — the one portability-debt
// seam. Per the marker-growth policy, a recurring shape should graduate to a real marker instead.
// Modifier: `%% sitetile: embed wide %%` → `.is-wide` (full-bleed marketing band); default hugs the
// theme content width (site.css .st-embed → --gd-max) so an embedded coral reads as page content.
// The markup is packages/emit/embed.mjs (tile-lab#52); this component reads the params and hands
// their values over.
import { parseParams } from '@sitetile';
import { emitEmbed } from '@emit/embed.mjs';
const { section } = Astro.props;
---
<Fragment set:html={emitEmbed(section, { wide: parseParams(section.params).wide })} />
