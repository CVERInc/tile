---
// `carousel` coral — single-row sibling of gallery. Same image-first cards (cast / archive /
// portfolio), but laid in a horizontal scroll track with prev/next arrows (slidesToShow via
// `cols=`). For casts/archives too long for a static grid (the slick-carousel shape). Mirrors the
// reference renderSection 'carousel' case so the editor live-preview matches the Astro build.
// The hoisted <script> below is emitted ONCE by Astro (deduped) and wires every `.st-carousel`.
import { parseParams, inlineHtml, bodyHtml, firstImage, imgTag } from '@sitetile';
import { postUrl } from '../../lib/blog.mjs';
const { section, blogPosts = [], meta = {} } = Astro.props;
const pm = parseParams(section.params);
// `eyebrow="…"` — the small label above the heading, the same seam Hero/Prose/Collection
// already had. 🩸 It was on those three and not on the rest, with nothing in the grammar
// explaining the split, so authors reasonably put it everywhere: 22 inert `eyebrow=` on
// one customer site alone. Every coral here renders a heading, which is the thing an
// eyebrow sits above — the inconsistency was arbitrary. Absent → no DOM change.
const eyebrow = pm.eyebrow ? (typeof pm.eyebrow === 'object' ? pm.eyebrow.label : pm.eyebrow) : null;
// `posts=N` — OPT-IN: auto-source cells from the site's N newest blog posts (a home "recent
// posts / NEWS" strip) instead of hand-listed ### cells. Needs `packages: blog` — PageView passes
// the already-loaded, newest-first `blogPosts` down; absent (no blog / param off) → hand-listed
// cells render byte-identically. Each post → an image-first cell: featured image + date (YY/M/D) +
// title, linking to the post's real URL (postUrl expands the site's blog-url-pattern).
const postCount = pm.posts ? parseInt(pm.posts, 10) : 0;
const newsDate = (s) => {
  const m = /^(\d{4})-(\d{1,2})-(\d{1,2})/.exec(String(s || ''));
  return m ? `${m[1].slice(2)}/${Number(m[2])}/${Number(m[3])}` : '';
};
// Only posts WITH a featured image — this is an image-first carousel, and a card with no
// thumbnail (a text-only announcement post) reads as broken. `parsePost` exposes it as `image`.
const cells = (postCount > 0 && blogPosts.length)
  ? blogPosts.filter((p) => p.image).slice(0, postCount).map((p) => ({ title: p.title, href: postUrl(p, meta), date: newsDate(p.date), body: `![](${p.image})` }))
  : (section.cells || []);
// `more="LABEL=/href"` — OPT-IN "view all" link rendered top-right of the heading row (a section
// that also links to a full listing). General — any carousel fronting a longer collection.
const moreRaw = pm.more ? (typeof pm.more === 'object' ? pm.more.label : pm.more) : null;
const more = moreRaw && moreRaw.includes('=')
  ? { label: moreRaw.split('=')[0].trim(), href: moreRaw.split('=').slice(1).join('=').trim() }
  : null;
// `start=N` — OPT-IN initial resting card index (0-based). General param, mirrors `cols=`: any
// carousel whose source (e.g. a JS slick-carousel on the original site) settles on a non-zero
// slide by default can be matched by setting the recast's initial scroll position to N cards in.
// Wired at runtime in the hoisted <script> below via the track's `data-start` attribute.

// `card=blog-full` — OPT-IN cell layout for a carousel fronting FULL blog posts (byline + fixed-
// height title + padded excerpt + a real CTA button), as opposed to the default caption-card cell
// (cast/archive/shop). Diagnosed against a live home-page carousel (a WP UAGB post-carousel,
// block b486e93b): an empty byline slot (23px), a 2-line-reserved title, a 25px excerpt bottom
// padding, and "繼續閱讀" rendered as a filled button, not bare text. Explicit string check (not a
// generic truthy/data-driven flag) so no other carousel — including a cols=6 character carousel
// included — picks this up by accident; only sections that opt in via this exact param get the
// extra `.st-car-byline` div + `.st-car-cell-blogfull` class (all styling lives in the theme,
// scoped to home's 3-col carousel). Cell class/markup unchanged for every carousel that omits it.
const isBlogFull = pm.card === 'blog-full';

function arrowSvg(left = false) {
  const dir = left ? ' signet-arrow--left' : '';
  return `<span class="signet-arrow${dir}" style="width:18px;height:18px;--signet-arrow-w:18px" aria-hidden="true"><span class="signet-arrow__tail"></span><svg class="signet-arrow__head" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="10 6 16 12 10 18"/></svg></span>`;
}
---
<section class="st-carousel" data-cols={pm.cols || ''}>
  {(section.title || more || eyebrow) && (
    <div class="st-car-head">
      {eyebrow && <p class="st-carousel-eyebrow" set:html={inlineHtml(eyebrow)} />}
      {section.title && <h2 set:html={inlineHtml(section.title)} />}
      {more && <a class="st-car-more" href={more.href} set:html={inlineHtml(more.label)} />}
    </div>
  )}
  {section.body && <Fragment set:html={bodyHtml(section.body)} />}
  <div class="st-car-viewport">
    <button class="st-car-nav st-car-prev" type="button" aria-label="Previous"><span class="st-sr-only">Previous</span><Fragment set:html={arrowSvg(true)} /></button>
    <div class="st-car-track" data-start={pm.start || ''}>
      {cells.map((c) => {
        const fi = firstImage(c.body);
        const fig = fi.img ? `<figure class="st-gal-fig">${imgTag(fi.img.alt, fi.img.src)}</figure>` : '';
        const badge = c.badge ? <span class="st-cell-badge" data-badge={String(c.badge).toLowerCase()} set:html={inlineHtml(c.badge)} /> : null;
        const cta = c.cta ? <span class="st-cell-cta st-cell-cta-labeled"><span class="st-cta-label" set:html={inlineHtml(c.cta)} /></span> : null;
        const inner = (
          <Fragment>
            {badge}
            <Fragment set:html={fig} />
            {c.date && <p class="st-car-date">{c.date}</p>}
            <h3 set:html={inlineHtml(c.title)} />
            {isBlogFull && <div class="st-car-byline" aria-hidden="true"></div>}
            <Fragment set:html={bodyHtml(fi.rest)} />
            {cta}
          </Fragment>
        );
        const cellClass = 'st-car-cell st-gal-cell' + (isBlogFull ? ' st-car-cell-blogfull' : '');
        return c.href
          ? <a class={`${cellClass} st-cell-link group`} href={c.href}>{inner}</a>
          : <div class={cellClass}>{inner}</div>;
      })}
    </div>
    <button class="st-car-nav st-car-next" type="button" aria-label="Next"><span class="st-sr-only">Next</span><Fragment set:html={arrowSvg(false)} /></button>
  </div>
</section>

<script>
  // Vanilla carousel runtime — wires every `.st-carousel` on the page. Arrows scroll the track by
  // ~one viewport; nav buttons hide when the track isn't overflowing or an end is reached.
  function initCarousels() {
    document.querySelectorAll('.st-carousel').forEach((root) => {
      if (root.dataset.carInit) return;
      root.dataset.carInit = '1';
      const track = root.querySelector('.st-car-track');
      const prev = root.querySelector('.st-car-prev');
      const next = root.querySelector('.st-car-next');
      if (!track || !prev || !next) return;
      const step = () => Math.max(track.clientWidth * 0.85, 200);
      // OPT-IN `start=N`: jump the track to rest on card N (0-based) instead of card 0. Used to
      // match a source site's carousel that settles on a non-zero slide by default.
      const startIdx = parseInt(track.dataset.start || '', 10);
      if (Number.isFinite(startIdx) && startIdx > 0) {
        const firstCell = track.querySelector('.st-car-cell');
        if (firstCell) {
          const cellRect = firstCell.getBoundingClientRect();
          const cs = getComputedStyle(track);
          const gap = parseFloat(cs.columnGap || cs.gap || '0') || 0;
          track.scrollLeft = startIdx * (cellRect.width + gap);
        }
      }
      // Adaptive height — GENERAL `carousel` coral behavior (always on, no opt-in param): the
      // track's height should equal the max natural height of only the cells currently visible
      // within the viewport's horizontal bounds, not the tallest cell across the ENTIRE track.
      // Mirrors slick-carousel's live behavior (it only lays out the visible N cards per `cols=`
      // at a time, so its row height never sees off-screen tall cells). Our CSS previously laid
      // every cell in one flex row with align-items:stretch-equivalent sizing, so the row was
      // sized to the tallest cell anywhere in the track, even off-screen ones — a genuine
      // structural gap (diagnosed on a live home carousel, ~70-120px residual drift).
      // Safe for uniform-height carousels: when every cell is the
      // same height, max(visible) === max(all), so this is a no-op there.
      const cells = () => Array.from(track.querySelectorAll('.st-car-cell'));
      const adaptHeight = () => {
        const vpRect = root.querySelector('.st-car-viewport').getBoundingClientRect();
        let maxH = 0;
        cells().forEach((cell) => {
          const r = cell.getBoundingClientRect();
          // Horizontal intersection with the viewport's own visible bounds (accounts for
          // scrollLeft implicitly, since getBoundingClientRect is viewport-relative already).
          const visible = r.right > vpRect.left + 0.5 && r.left < vpRect.right - 0.5;
          // getBoundingClientRect().height (fractional) not offsetHeight (integer-floored) — the
          // floor can leave the row a px short; combined with the ceil below, the box never
          // under-sizes a visible card.
          if (visible) maxH = Math.max(maxH, r.height);
        });
        // maxH is the cells' CONTENT height; the track is border-box with vertical padding, so
        // setting height=maxH would leave the content area short by that padding → the cells then
        // overflow the row by ~padding px, giving a tiny internal vertical scroll (no scrollbar,
        // but the row nudges — caught in a real-Safari pass 2026-07-14). Add the padding back so the
        // content area equals maxH exactly.
        if (maxH > 0) {
          const cs = getComputedStyle(track);
          const padY = cs.boxSizing === 'border-box'
            ? parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom) : 0;
          track.style.height = Math.ceil(maxH + (padY || 0)) + 'px';
        }
      };
      const update = () => {
        const max = track.scrollWidth - track.clientWidth - 1;
        const overflow = max > 0;
        root.classList.toggle('st-car-has-overflow', overflow);
        prev.disabled = !overflow || track.scrollLeft <= 1;
        next.disabled = !overflow || track.scrollLeft >= max;
        adaptHeight();
      };
      prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
      // Re-run after late settling — a cell that grows a few px when its webfont or image finishes
      // (after the initial update) would otherwise leave the row a touch short, clipping the card
      // bottom by those px. `load` and `fonts.ready` are the definitive "everything settled" signals.
      window.addEventListener('load', update);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(update);
      // Re-run height adaptation whenever a cell's rendered size changes AFTER init — most
      // importantly when late-loading images finish loading. Cards with no reserved aspect box
      // (height:auto images, e.g. a row of comic covers) measure text-only at init, so the
      // one-shot update() above pins the track to a too-short height and the tall images then
      // overflow the row (spilling over the footer, a ~340px doc-height deficit). Observing the
      // cells (rAF-debounced) re-sizes the row to the real card height once images/fonts settle.
      // No-op for uniform fixed-aspect carousels: the height is already correct
      // at init and re-measuring yields the same value.
      if (window.ResizeObserver) {
        let raf = 0;
        const ro = new ResizeObserver(() => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(adaptHeight);
        });
        cells().forEach((cell) => ro.observe(cell));
      } else {
        track.querySelectorAll('img').forEach((img) => {
          if (!img.complete) img.addEventListener('load', adaptHeight, { once: true });
        });
      }
    });
  }
  if (document.readyState !== 'loading') initCarousels();
  else document.addEventListener('DOMContentLoaded', initCarousels);
</script>
