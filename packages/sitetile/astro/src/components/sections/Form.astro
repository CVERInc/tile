---
// `form` — a contact / inquiry form: an optional lead (intro), then one field per `### <label>`
// (parsed in site-core.js: a trailing `{email}`/`{tel}`/`{textarea}` sets the input kind, `- option`
// lines under a field become a <select>). Renders a native <form> with <label> + <input>/<textarea>/
// <select> per field + a submit button; the THEME paints `.st-form-*`. This coral carries only
// STRUCTURE — the `action`/`method` params wire submission (a deploy concern, per
// cutover-structure-before-data); with no action the submit button renders DISABLED — 🩸 it used
// to render live and post to the page's own URL, which on a static host is a 405 the visitor never
// sees (measured on sodaart, 2026-08-15). "Never claims a backend it lacks" was in this comment
// before it was in the markup. `action=inbox` is the one special value — a fixed, wired route to
// feelreef's own same-origin inbox forwarder; see the note below. Family posture: CommonMark, one `%% sitetile: %%` sentinel, native elements,
// zero-JS, GAIDO-editable (fields live in the Markdown). A near-universal contact widget no other
// coral expresses — grown when a real /contact page hit the wall (recast doctrine: hit a wall,
// grow a GENERAL coral).
import { parseParams, inlineHtml, bodyHtml } from '@sitetile';
import { inboxFormCopy, DEFAULT_LANG } from '../../packages/lingo/locale.mjs';
const { section, hero, lang } = Astro.props;
const Title = hero && section.title ? 'h1' : 'h2';   // first section on the page → its title is the <h1>
const pm = parseParams(section.params);
// `eyebrow="…"` — the small label above the heading, the same seam every other
// heading-bearing coral now has. 🩸 Three had it and six did not, with nothing in the
// grammar explaining the split; authors reasonably used it everywhere and it silently
// did nothing. Absent → no DOM change.
const eyebrow = pm.eyebrow ? (typeof pm.eyebrow === 'object' ? pm.eyebrow.label : pm.eyebrow) : null;
const submit = pm.submit || 'Send';
const fields = section.fields || [];
const idOf = (i) => 'st-form-f' + (i + 1);

// ── 🩸 `inbox=` IS BACK, 2026-09-03 — the same-origin route it needed exists now ──
//
// It first shipped on 2026-08-15 and was withdrawn the same day: the idea then was
// one param pointing the form straight at feelreef's `/api/inbox`, cross-origin.
// That cannot work — feelreef is a SvelteKit app, and SvelteKit refuses any
// cross-origin POST whose content type is a FORM type, app-wide, before routing
// (`Cross-site POST form submissions are forbidden` — the same check that protects
// the dashboard's reply/claim actions, signup, checkout, the pay links). No enctype
// a browser sends for a plain `<form>` dodges it.
//
// The withdrawal note said the fix was a SAME-ORIGIN route: the form posts to the
// site's own path and the site's emitted `_worker.js` forwards it server-to-server.
// That forwarder now exists on the reef side, so this coral's half is just wiring
// `action=inbox` to it — a fixed, non-configurable contract:
//
//   • `action=inbox` → `<form action="/__reef/inbox" method="post">`. `method=` is
//     ignored for this value — the forwarder only accepts POST.
//   • Two hidden inputs the forwarder reads: `return_to` (this page's own path,
//     locale-aware — Astro.url.pathname already carries the locale segment) and a
//     honeypot `_hp` (visually hidden, NOT `display:none`, so a bot's autofill still
//     reaches it — a display:none field is exactly what a scripted filler is taught
//     to skip; kept out of the tab order and off-screen instead).
//   • No `kind`/`id` param here — the forwarder bakes the site key server-side. This
//     coral still carries only STRUCTURE, per cutover-structure-before-data.
//   • Field naming: the `{email}` field is posted as `visitor_email` (the forwarder's
//     one semantic field — it composes every other field into the message body under
//     its own visible label). A label that collides with one of the forwarder's
//     reserved names gets `field_` prefixed on the WIRE name only — the visible
//     `<label>` text an author wrote never changes.
//
// 🔴 Do not re-add a version of this that posts straight to feelreef.com. It will
// look correct in every test that calls the endpoint directly, and fail for every
// real visitor — that is the exact failure this route exists to avoid.
const action = pm.action || undefined;
const isInbox = action === 'inbox';
const method = isInbox ? 'post' : (pm.method || 'post').toLowerCase();
const formAction = isInbox ? '/__reef/inbox' : action;

// The forwarder's reserved field names — an owner field must never land on the wire
// under one of these, or it would be read as routing data instead of message content.
// Checked case-insensitively (the forwarder's own keys are all lowercase) so a field
// authored as "Kind" or "Text" cannot collide either. The visible label is untouched;
// only the wire `name=` gets `field_` prefixed.
const RESERVED_INBOX_NAMES = new Set(['kind', 'id', 'text', 'conversation_id', 'page_url', 'return_to', '_hp', 'visitor_email', 'email_field']);
const inboxNameFor = (label, kind) => {
  if (kind === 'email') return 'visitor_email';
  const s = String(label);
  return RESERVED_INBOX_NAMES.has(s.toLowerCase()) ? `field_${s}` : s;
};
const nameFor = (f) => (isInbox ? inboxNameFor(f.label, f.kind) : f.label);
// `return_to` — locale-aware because Astro.url.pathname IS the built path, which
// already carries the locale segment for every non-default-locale page (the router
// bakes it in via toUrlLocale; see lib routing). Read once, per page render.
const returnTo = Astro.url.pathname;

// 🔴 A form with nowhere to send is not a form with a working button. Before
// this, an unwired coral rendered a live submit that posted to the page's own
// URL — which on a static host is a 405 the visitor cannot see: they type, they
// press, the words vanish, and nothing says so. The header above already claimed
// "never claims a backend it lacks"; a pressable button was claiming one.
const wired = Boolean(action);

// ── required fields (2026-09-03, cold-read findings #9/#10) ────────────────────────────────────
// Before this, EVERY field rendered `required=false` — blank was indistinguishable from filled,
// so a form with nothing in it "sent successfully" with no field flagged and the owner received an
// empty message. `f.required` (site-core.js's new brace grammar) wins whenever an author states
// one, either way; unstated, `action=inbox` defaults ONLY its message textarea and email field —
// the two the forwarder actually needs to do anything with the submission — everything else
// (a plain `{tel}`, a name field, a non-inbox form entirely) stays exactly as permissive as before.
function isRequired(f) {
  if (typeof f.required === 'boolean') return f.required;
  return isInbox && (f.kind === 'textarea' || f.kind === 'email');
}
// Locale copy for the marker's error text + the two "what happens next" success variants below.
// Its OWN small table (see locale.mjs) — not `uiCopy`'s four Lingo site locales — because it
// distinguishes Simplified from Traditional, which `uiCopy` does not.
const fieldCopy = inboxFormCopy(lang || DEFAULT_LANG);
const renderFields = fields.map((f, i) => ({ ...f, id: idOf(i), name: nameFor(f), required: isRequired(f) }));
// 🔴 Knowable at BUILD time, not by echoing what the visitor typed back through the redirect: an
// email field that is REQUIRED is, by construction, filled on every submission the browser lets
// through at all (that's what `required` means) — so which success sentence applies is a fact
// about this form's own configuration, not about one particular visitor's request. An email field
// that is present but explicitly opted OUT of the default (`required: false`) may or may not have
// been filled, so it gets the same safe fallback as having no email field at all.
const emailGuaranteed = isInbox && renderFields.some((f) => f.kind === 'email' && f.required);
const inboxSentText = emailGuaranteed ? fieldCopy.sentWithEmailGeneric : fieldCopy.sentNoEmail;

// ── post-submit feedback: submitting / success card / inline retry error ───────────────────────
// (owner ruling, 2026-09-03: a same-size paragraph under a form that STAYS is too weak a signal —
// measured as visitors resubmitting because nothing told them it had already worked). The
// STATIC markup above (inboxSentText, the disabled-by-default success card, the error line) is
// the full experience for a no-JS visitor after the real POST → 303 → reload round trip; the
// `is:inline` script below is a progressive AJAX enhancement over the exact same `formAction` —
// same contract, same `/__reef/inbox` forwarder, same `?inbox=<outcome>` vocabulary — that avoids
// the reload entirely so it can show a "submitting…" state, keep the visitor's typed values on
// failure, and (JS-only, since only the browser ever holds it) fill the real email address into
// the success sentence and quote back what they wrote. No fetch to feelreef.com, no new endpoint —
// see the file-header note above `RESERVED_INBOX_NAMES` for why that road stays closed.
//
// `emailField`/`excerptField` are the WIRE names (post-`nameFor` — `visitor_email`, or an
// author's own field label) so the client script can `FormData.get()` them without re-deriving
// the reserved-name/collision rules that already ran at build time.
const emailFieldName = renderFields.some((f) => f.kind === 'email') ? 'visitor_email' : null;
const excerptField = renderFields.find((f) => f.kind === 'textarea');
const inboxCopy = isInbox ? {
  submitting: fieldCopy.submitting,
  successHeading: fieldCopy.successHeading,
  errorNetwork: fieldCopy.errorNetwork,
  errorServer: fieldCopy.errorServer,
  // Templates the script fills in with what only the browser ever holds — see locale.mjs's note
  // on `sentWithEmail` vs `sentWithEmailGeneric` (the latter is what inboxSentText above uses).
  sentWithEmail: fieldCopy.sentWithEmail,
  sentNoEmail: fieldCopy.sentNoEmail,
  emailField: emailFieldName,
  excerptField: excerptField ? excerptField.name : null,
} : null;
---
<section class="st-form-section" id={section.id} data-inbox-copy={inboxCopy ? JSON.stringify(inboxCopy) : undefined}>
  <div class="st-form-head">
    {eyebrow && <p class="st-form-eyebrow" set:html={inlineHtml(eyebrow)} />}
    {section.title && <Title set:html={inlineHtml(section.title)} />}
    {section.body && <Fragment set:html={bodyHtml(section.body)} />}
  </div>
  {isInbox && (
    // The success CARD — replaces the whole form on submit (hidden, not removed: focus lands here
    // and screen-reader users still have the form's own DOM to tab back into if they want it).
    // `role="status"` + `tabindex="-1"` so the script can move focus AND have it announced without
    // adding this element to the normal tab order the rest of the time.
    <div class="st-form-success" data-inbox-success role="status" tabindex="-1" hidden>
      <svg class="st-form-success-check" viewBox="0 0 48 48" width="40" height="40" aria-hidden="true" focusable="false">
        <circle cx="24" cy="24" r="21" fill="none" stroke="currentColor" stroke-width="3"></circle>
        <path d="M14 25l7 7 14-15" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <p class="st-form-success-heading" role="heading" aria-level="3">{fieldCopy.successHeading}</p>
      {/* Server-rendered default (a no-JS visitor, after the real POST → 303 → reload, sees exactly
          this): the safe generic sentence, since build time cannot know a per-submission email
          address. The script overwrites this text on a JS-handled submit — see below. */}
      <p class="st-form-success-next" data-inbox-next set:html={inlineHtml(inboxSentText)} />
      {/* Only ever filled in by the script (a no-JS submit has no typed values left to quote back
          after the redirect round trip) — stays hidden until it has something to show. */}
      <p class="st-form-success-excerpt" data-inbox-excerpt hidden></p>
      <p class="st-form-success-back"><a href="/">{fieldCopy.backHome}</a></p>
    </div>
  )}
  <form class="st-form" action={formAction} method={method}>
    {isInbox && (
      <input type="hidden" name="return_to" value={returnTo} />
    )}
    {isInbox && (
      // Honeypot: a real visitor never sees or tabs to this, so it stays empty; a
      // bot's autofill routine — which reads the DOM, not computed CSS — still finds
      // and fills it. Off-screen + zero-size, deliberately NOT `display:none`.
      <input type="text" name="_hp" autocomplete="off" tabindex="-1" aria-hidden="true"
        style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" />
    )}
    {renderFields.map((f) => (
      <div class="st-form-field">
        {/* Byte-identical to before for every field that stays optional (the common case, and
            every field on every pre-existing site) — the required marker's wrapper renders ONLY
            for a field that IS required, so nothing else moves. */}
        {f.required ? (
          <label class="st-form-label" for={f.id}>
            <span set:html={inlineHtml(f.label)} /><span class="st-form-required-mark" aria-hidden="true"> *</span>
          </label>
        ) : (
          <label class="st-form-label" for={f.id} set:html={inlineHtml(f.label)} />
        )}
        {f.kind === 'textarea' ? (
          <textarea class="st-form-input st-form-textarea" id={f.id} name={f.name} rows="5"
            required={f.required || undefined} aria-required={f.required || undefined}
            data-required-msg={f.required ? fieldCopy.fieldRequired : undefined}></textarea>
        ) : f.kind === 'select' ? (
          <select class="st-form-input st-form-select" id={f.id} name={f.name}
            required={f.required || undefined} aria-required={f.required || undefined}
            data-required-msg={f.required ? fieldCopy.fieldRequired : undefined}>
            <option value="" disabled selected>—</option>
            {(f.options || []).map((o) => <option value={o}>{o}</option>)}
          </select>
        ) : (
          <input class="st-form-input" id={f.id} name={f.name}
            type={f.kind === 'email' ? 'email' : f.kind === 'tel' ? 'tel' : 'text'}
            required={f.required || undefined} aria-required={f.required || undefined}
            data-required-msg={f.required ? fieldCopy.fieldRequired : undefined} />
        )}
      </div>
    ))}
    {isInbox && (
      // Inline, ABOVE the button (owner ruling): failure keeps the form and every value the
      // visitor already typed — nothing here is inside a `hidden` ancestor that would also hide
      // the fields — and the button re-enables so "再試一次" is just pressing it again, not
      // re-typing anything. Static default is the generic server-refusal sentence; the script
      // swaps in the network-vs-server distinction it alone can tell apart.
      <p class="st-form-error" data-inbox-error hidden set:html={inlineHtml(fieldCopy.errorServer)} />
    )}
    <button class="st-form-submit" type="submit" disabled={!wired}>{submit}</button>
  </form>
  {isInbox && (
    // Client-only status line: the build is static, so the coral cannot read `?inbox=` at build
    // time, capture what a visitor typed, or know whether a fetch it makes will succeed — only
    // the visitor's own browser can. Kept tiny and inline (no import, no event handler
    // attributes) like ArchiveView's tag-filter script, so it stays CSP-clean under a default
    // script-src, and it is a PROGRESSIVE ENHANCEMENT over the static markup above, never a
    // replacement for it — every branch below degrades to something that already worked.
    <script is:inline>
      (() => {
        const root = document.currentScript.closest('.st-form-section');
        if (!root) return;
        // Localized required-field messages (2026-09-03, finding #9): native `required` already
        // blocks an empty submit with ZERO js — this only swaps the browser's own generic bubble
        // text for the site-language one baked into `data-required-msg` at build time. `invalid`
        // fires per-field on a blocked submit attempt; `input` clears the custom message again the
        // moment the visitor starts fixing it, so a since-filled field doesn't keep re-showing it.
        root.querySelectorAll('[data-required-msg]').forEach((el) => {
          el.addEventListener('invalid', () => { el.setCustomValidity(el.validity.valueMissing ? el.dataset.requiredMsg : ''); });
          el.addEventListener('input', () => { el.setCustomValidity(''); });
        });
        // ── post-submit feedback (owner ruling, 2026-09-03) ─────────────────────────────────────
        const form = root.querySelector('.st-form');
        const successEl = root.querySelector('[data-inbox-success]');
        const errorEl = root.querySelector('[data-inbox-error]');
        const nextEl = root.querySelector('[data-inbox-next]');
        const excerptEl = root.querySelector('[data-inbox-excerpt]');
        const btn = form && form.querySelector('.st-form-submit');
        // The button's OWN rendered label (whatever `submit="…"` the author wrote, or the
        // default) — captured now, before anything can change it, so a failed submit restores
        // exactly this rather than a hardcoded guess.
        const btnDefaultText = btn ? btn.textContent : null;
        let copy = null;
        try { copy = JSON.parse(root.dataset.inboxCopy || 'null'); } catch (e) { copy = null; }

        // Two LINES, the way a person reads a quoted excerpt back — split on the visitor's own
        // newlines rather than a character count, which would cut mid-word; a single very long
        // line still gets a CSS line-clamp as a visual fallback (site.css `.st-form-success-excerpt`).
        function twoLineExcerpt(raw) {
          return String(raw || '').trim().split(/\r?\n/).map((l) => l.trim()).filter(Boolean).slice(0, 2).join('\n');
        }

        // `fd` is the FormData captured at submit time — only ever present on the JS-handled path.
        // A no-JS visitor's real POST navigates away and back; nothing they typed survives that
        // round trip, so `fd` is null there and the excerpt/exact-address text stay at their
        // build-time defaults (already rendered: the generic sentence, no excerpt paragraph).
        function showSuccess(fd) {
          if (form) form.hidden = true;
          if (errorEl) errorEl.hidden = true;
          if (!successEl) return;
          if (copy && nextEl && fd) {
            const addr = copy.emailField ? String(fd.get(copy.emailField) || '').trim() : '';
            nextEl.textContent = addr ? copy.sentWithEmail.replace('{email}', addr) : copy.sentNoEmail;
          }
          if (excerptEl) {
            const excerpt = copy && copy.excerptField && fd ? twoLineExcerpt(fd.get(copy.excerptField)) : '';
            if (excerpt) { excerptEl.textContent = excerpt; excerptEl.hidden = false; }
            else excerptEl.hidden = true;
          }
          successEl.hidden = false;
          successEl.focus();
          if (successEl.scrollIntoView) successEl.scrollIntoView({ block: 'center' });
        }

        // Failure keeps the form exactly as the visitor left it — this never touches field
        // values, only the error line and the button — and re-enables the button so trying again
        // is pressing it, not retyping anything.
        function showError(message) {
          if (errorEl) {
            if (message) errorEl.textContent = message;
            errorEl.hidden = false;
          }
          if (btn) {
            btn.disabled = false;
            btn.removeAttribute('aria-busy');
            if (btnDefaultText != null) btn.textContent = btnDefaultText;
          }
        }

        // No-JS-equivalent fallback: a real submit navigated away and the browser came back here
        // with `?inbox=<outcome>` — the forwarder's own 303 contract, unchanged. Same two states,
        // just without a captured FormData to enrich them with.
        const v = new URLSearchParams(location.search).get('inbox');
        if (v === 'sent') showSuccess(null);
        else if (v) showError(copy ? copy.errorServer : null);

        if (!form || !btn || typeof window.fetch !== 'function') return; // native submit still works fine without this

        let submitting = false;
        form.addEventListener('submit', (ev) => {
          if (submitting) { ev.preventDefault(); return; } // no double submit — the button is
          ev.preventDefault();                              // disabled too, but Enter can outrace a click
          submitting = true;
          if (errorEl) errorEl.hidden = true;
          btn.disabled = true;
          btn.setAttribute('aria-busy', 'true');
          if (copy && copy.submitting) btn.textContent = copy.submitting;
          const fd = new FormData(form);
          fetch(form.getAttribute('action'), { method: 'POST', body: fd })
            .then((res) => {
              submitting = false;
              // fetch() follows the forwarder's 303 itself — the visible page never navigates —
              // so the outcome is read off the FINAL response's own URL, the same `?inbox=`
              // vocabulary a no-JS round trip would have landed the browser on.
              let outcome = '';
              try { outcome = new URL(res.url, location.href).searchParams.get('inbox') || ''; } catch (e) {}
              if (outcome === 'sent') showSuccess(fd);
              else showError(copy ? copy.errorServer : null);
            })
            .catch(() => {
              submitting = false;
              showError(copy ? copy.errorNetwork : null);
            });
        });
      })();
    </script>
  )}
</section>
