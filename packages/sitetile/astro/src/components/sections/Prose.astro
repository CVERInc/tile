---
// The markup is packages/emit/prose.mjs (tile-lab#52); this component reads the params and hands
// their values over.
import { parseParams } from '@sitetile';
import { emitProse } from '@emit/prose.mjs';
const { section, hero } = Astro.props;
const pm = parseParams(section.params);
// `align=left` opts a prose section out of the default centered lead-band styling
// (content-heavy pages like /about, /oss, legal read left-aligned).
const align = pm.align ? (typeof pm.align === 'object' ? pm.align.label : pm.align) : null;
// `ordered` (bare flag) = a numbered-sections prose (legal/policy). CONTENT stays plain
// `### Heading`s; the THEME decides how to number them (e.g. number-in-gutter
// ordered list). Block carries structure; theme carries the site-specific treatment.
const ordered = pm.ordered != null;
// 🩸 general (2026-07-05): a paragraph that's ONLY links (e.g. `[A](url) · [B](url)`)
// renders as real CTA buttons, mirroring Hero's identical `linksOnly`/`linkButtonsHtml` seam —
// found on a real /about page, where the closing links are bordered pill buttons, not inline
// text joined by "·". Reuses the exact same parser so both seams stay in lockstep.
// Every paragraph stays where it is written (reef#1933 S6): a links-only one is a button
// row in place, an images-only one a `figure.st-figure` in place. The body's markup lives in
// `proseBodyHtml`, which the string renderer's prose branch calls too — written out here instead,
// the two renderers gave one body two different structures.
// `surface=<token>` — OPT-IN per-section background belt (cream/teal). Absent → the prose
// section stays transparent (theme default). Styled by the THEME (`[data-surface]`).
const surface = pm.surface ? (typeof pm.surface === 'object' ? pm.surface.label : pm.surface) : undefined;
// `eyebrow="…"` — OPT-IN small label above the heading, same seam as Hero's identical param
// (`st-hero-eyebrow`/`eyebrow=`). Found on a real product page: a teal cross-sell belt
// has a "REEF + MixFairy" label above the h2 that the prose block had no way to express — general
// Card-family primitive, not a mixfairy-only hack. Absent → no DOM change (byte-identical elsewhere).
const eyebrow = pm.eyebrow ? (typeof pm.eyebrow === 'object' ? pm.eyebrow.label : pm.eyebrow) : null;
---
<Fragment set:html={emitProse(section, { eyebrow, align, ordered, surface }, { hero })} />
