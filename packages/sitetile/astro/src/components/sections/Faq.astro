---
// `faq` — a Q&A accordion: an optional lead (intro/subtitle), then `### <question>` + answer body
// per item. Renders to native <details>/<summary> — zero-JS, accessible, progressive-enhancement
// (the family posture: no framework, CommonMark structure, one `%% sitetile: %%` sentinel for the
// layout type). `open` (bare flag) expands every item on load (a live all-expanded FAQ — e.g.
// matching a SiteOrigin `.mp-accordion` default state); absent → collapsed. An answer body may
// lead with a `###### <bold summary>` (h6), the exact shape live FAQs use for the one-line answer.
// The THEME paints the disclosure chrome. Mirrors the reference renderer in site-core.js.
import { parseParams, inlineHtml, bodyHtml } from '@sitetile';
const { section, hero } = Astro.props;
const Title = hero && section.title ? 'h1' : 'h2';   // first section on the page → its title is the <h1>
const pm = parseParams(section.params);
// `eyebrow="…"` — the small label above the heading, the same seam Hero/Prose/Collection
// already had. 🩸 It was on those three and not on the rest, with nothing in the grammar
// explaining the split, so authors reasonably put it everywhere: 22 inert `eyebrow=` on
// one customer site alone. Every coral here renders a heading, which is the thing an
// eyebrow sits above — the inconsistency was arbitrary. Absent → no DOM change.
const eyebrow = pm.eyebrow ? (typeof pm.eyebrow === 'object' ? pm.eyebrow.label : pm.eyebrow) : null;
const openAll = pm.open != null;
const faqs = section.faqs || [];
---
<section class="st-faq" id={section.id}>
  <div class="st-faq-head">
    {eyebrow && <p class="st-faq-eyebrow" set:html={inlineHtml(eyebrow)} />}
    {section.title && <Title set:html={inlineHtml(section.title)} />}
    {section.body && <Fragment set:html={bodyHtml(section.body)} />}
  </div>
  <div class="st-faq-list">
    {faqs.map((e) => (
      <details class="st-faq-item" open={openAll}>
        <summary class="st-faq-q" set:html={inlineHtml(e.q)} />
        <div class="st-faq-a" set:html={bodyHtml(e.body)} />
      </details>
    ))}
  </div>
</section>
