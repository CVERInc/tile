---
// Recursive header-nav node. Renders one menu item and, if it has children, a `.rf-nav-sub`
// submenu whose children are rendered by the SAME component (Astro.self) — so the menu goes to
// ARBITRARY depth. depth 0 = top bar (`.rf-nav-link`); deeper leaves add `.rf-nav-sublink`;
// any node with children is a `.rf-nav-group` (2nd+ level also `.rf-nav-subgroup`, opens to the side).
import { safeHref } from '@sitetile';
const { item, depth = 0 } = Astro.props;
const ext = (h) => /^https?:\/\//i.test(h || '') ? { target: '_blank', rel: 'noopener' } : {};
const kids = item && item.children && item.children.length ? item.children : null;
const topLeaf = depth === 0;
// round 3 (Astro consumers, R2-P3-5): `item.href` is an author-set nav destination (site
// frontmatter `nav:`), reaching a live `<a href>` with no scheme check of its own. `safeHref`
// shares the same policy site-core.js's own emitters use; a disallowed destination degrades to
// plain text (the label, no anchor) rather than going live.
const hrefOk = safeHref(item.href);
---
{kids
  ? <span class={depth === 0 ? 'rf-nav-group' : 'rf-nav-group rf-nav-subgroup'}>
      {hrefOk
        ? <a class={'rf-nav-link rf-nav-parent' + (topLeaf ? '' : ' rf-nav-sublink')} href={hrefOk} {...ext(hrefOk)}>{item.label}</a>
        : <span class={'rf-nav-link rf-nav-parent' + (topLeaf ? '' : ' rf-nav-sublink')}>{item.label}</span>}
      <span class="rf-nav-sub">{kids.map((c) => <Astro.self item={c} depth={depth + 1} />)}</span>
    </span>
  : hrefOk
    ? <a class={topLeaf ? 'rf-nav-link' : 'rf-nav-link rf-nav-sublink'} href={hrefOk} {...ext(hrefOk)}>{item.label}</a>
    : <span class={topLeaf ? 'rf-nav-link' : 'rf-nav-link rf-nav-sublink'}>{item.label}</span>}
