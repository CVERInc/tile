---
// REEF with Blog — WordPress-style tag archive at /tag/<slug>/, PAGE 1 (pages 2+ live at
// /tag/<slug>/page/<n> in ./page/[n].astro). WordPress publishes term archives at `/tag/<slug>/`
// (slug, not display name) and links them from post meta, tag clouds, and — where present — the
// home "固定角色介紹" character cards. Those old URLs must survive cutover, so this route makes
// them real (mirrors the Blogger /search/label route, but slug-keyed + WP base).
//
// This is the taxonomy half of the "copy WordPress's routing capability" decision (the post
// half is postUrl's %postname% permalink expansion in blog.mjs). Rendering is delegated to the
// shared ArchiveView so /tag /category /author /YYYY all wear one non-drifting shell.
//
// slug ≠ name: posts carry the tag's DISPLAY name (e.g. `研究筆記 RESEARCH`); the URL uses WP's slug
// (`clerk`). `blog-tag-slugs: Name=slug | …` in _site.md maps the two (English-slug tags only;
// CJK tags whose slug == name need no entry — slug defaults to the name, URL-encoded like live).
//
// OPT-IN: emits nothing unless the site's home meta sets `blog-tag-routes` truthy.
import ArchiveView from '../../../components/ArchiveView.astro';
import { allPosts, siteMeta, tagSlugMap, archivePrefixes} from '../../../lib/blog.mjs';

export function getStaticPaths() {
  const posts = allPosts(
    import.meta.glob('../../../../blog/*.md', { query: '?raw', import: 'default', eager: true })
  );
  const meta = siteMeta(
    import.meta.glob('../../../../content/*.md', { query: '?raw', import: 'default', eager: true })
  );
  const on = meta['blog-tag-routes'] != null && String(meta['blog-tag-routes']) !== 'false';
  if (!on) return [];
  const slugMap = tagSlugMap(meta);
  const seen = new Set();
  const tags = [];
  for (const p of posts) for (const t of p.tags) if (t && !seen.has(t)) { seen.add(t); tags.push(t); }
  return tags.map((tag) => ({ params: { slug: slugMap[tag] || tag }, props: { posts, meta, tag, slug: slugMap[tag] || tag } }));
}

const { posts, meta, tag, slug } = Astro.props;
const base = String(meta['blog-tag-base'] || '/tag').replace(/\/$/, '');
const labelPosts = posts.filter((p) => p.tags.includes(tag));
const subhead = archivePrefixes(meta).tag + tag;
const pageHref = (n) => (n === 1 ? `${base}/${slug}` : `${base}/${slug}/page/${n}`);
---
<ArchiveView posts={labelPosts} corpus={posts} meta={meta} title={`${tag} — ${meta.title || ''}`}
  heading={tag} subhead={subhead} pageHref={pageHref} pageNum={1} />
