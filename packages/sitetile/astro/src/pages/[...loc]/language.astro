---
// REEF with Lingo — the `/language` chooser page (the PRIMARY locale switcher).
// GENERAL Lingo capability: an ENGINE page (not authored IR content). It renders at the root
// `/language` (site default locale) AND locale-prefixed `/<loc>/language` for every other locale,
// wearing the same SiteLayout shell (so header/footer/logo/theme match the locale's home page).
//
// Behaviour (matches a live /language page):
//   • title + heading + lead + per-row action are localized to the PAGE's locale.
//   • each row links to that locale's ROOT (default → /, others → /<loc>/), marked Current/Switch.
//   • honors ?return=<path> (+ optional ?has=<csv of locales that HAVE that path>): a tiny inline
//     script rewrites each row's href to the return path, per-locale-prefixed — same script as live.
//   • the suggestion banner is suppressed here (SiteLayout's localeBanner.excludePath = '/language').
import SiteLayout from '../../layouts/SiteLayout.astro';
import { localeEditions, editionMeta } from '../../lib/locale-editions.mjs';
import { toUrlLocale, label, languageCopy, rootLangMismatch, localesSourceOf } from '../../packages/lingo/locale.mjs';
// As TEXT, for SiteLayout to place ahead of the site's theme. A plain `import '….css'` arrives
// through Astro's own <style>, after the theme — see `routeCss` in SiteLayout.
import languagePageCss from '../../packages/lingo/language-page.css?raw';
// …and as a function of that theme: a part of this page the theme names is the owner's to lay out.
import { chooserCss } from '../../packages/lingo/language-page-css.mjs';

export function getStaticPaths() {
  // Discover the site's locale set + per-locale chrome from the HOME pages authored in content/.
  // The loop itself lives in lib/locale-editions.mjs, shared with the per-locale 404 route
  // (CVERInc/reef#2112) so the two can never disagree about which editions this site has.
  const files = import.meta.glob('../../../content/**/*.md', { query: '?raw', import: 'default', eager: true });
  const editions = localeEditions(files);
  if (!editions) return [];
  const { rootHome, locales, defaultLocale } = editions;
  // …and when the root home page itself disagrees with that, say so. Here because this runs once
  // per build and already holds the root home; the warning is the build log's, like loadSite's.
  const mismatch = rootLangMismatch({ locales, rootLang: rootHome.lang, source: localesSourceOf(rootHome) });
  if (mismatch) console.warn(mismatch);

  return locales.map((L) => {
    const meta = editionMeta(editions, L);
    const url = toUrlLocale(L);
    return {
      params: { loc: L === defaultLocale ? undefined : url },
      props: { pageLocale: L, defaultLocale, locales, meta },
    };
  });
}

const { pageLocale, defaultLocale, locales, meta } = Astro.props;
const copy = languageCopy(pageLocale);
// Resolved to a plain string BEFORE the client <script> template literal below — a prior version
// called `toUrlLocale(defaultLocale)` inline inside that nested backtick string, which threw
// "toUrlLocale is not defined" in the browser (the interpolation wasn't evaluating server-side as
// intended, silently breaking the ?return= path-preservation feature). A plain precomputed string
// removes any nested-template-literal ambiguity.
const defaultUrlLocale = toUrlLocale(defaultLocale);
// ALL url-locales (precomputed JSON) so the ?return= rewriter can strip the SOURCE locale prefix
// off the return path before re-prefixing per target locale — without this it treated e.g.
// "/zh-tw/" as the bare path, so English resolved to "/zh-tw/" (you couldn't switch back).
const urlLocalesJson = JSON.stringify(locales.map((L) => toUrlLocale(L)));
const rows = locales.map((L) => {
  const url = toUrlLocale(L);
  return {
    url,
    name: label(L),
    href: L === defaultLocale ? '/' : `/${url}/`,
    current: L === pageLocale,
  };
});
---
<SiteLayout title={copy.word} lang={pageLocale} meta={meta} alternates="all" routeCss={(themeCss) => chooserCss(languagePageCss, themeCss)}>
  <section class="rf-lang-page">
    <div class="rf-lang-head">
      <h1>{copy.word}</h1>
      <p>{copy.prompt}</p>
    </div>
    <ul class="rf-lang-list" aria-label={copy.word}>
      {rows.map((r) => (
        <li>
          <a href={r.href} hreflang={r.url} data-language-link data-locale={r.url}
             aria-current={r.current ? 'true' : undefined}>
            <span class="rf-lang-name">{r.name}</span>
            <span class="rf-lang-action">
              {r.current ? copy.current : copy.switch}
              {!r.current && (
                <svg class="rf-lang-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="10 6 16 12 10 18" /></svg>
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  {/* ?return=<path> (+ optional ?has=<locales with that path>) → rewrite each row to that page,
      per-locale-prefixed. Same contract as a live /language page. is:inline so it ships verbatim.
      🩸 CVERInc/reef#1910. `return` is a value anyone can put in a link, and the only check was
      "starts with one slash, not two". Three ways through that to another origin, each on the
      DEFAULT locale's row (the one row that gets no locale prefix): a backslash after the slash,
      which a browser reads as a second slash; a tab or newline between two slashes, which a browser
      deletes; and a locale prefix in front of two slashes, which bare() itself strips. Listing
      spellings is how the first check came to miss three, so same() asks the browser instead: the
      href is resolved and compared with this page's origin before it is written. A refused value
      leaves the row as built — that locale's home. */}
  <script is:inline set:html={`(function(){var LOCS=${urlLocalesJson},DEF="${defaultUrlLocale}";function bare(p){for(var i=0;i<LOCS.length;i++){var loc=LOCS[i];if(loc===DEF)continue;if(p==="/"+loc||p==="/"+loc+"/")return"/";if(p.indexOf("/"+loc+"/")===0)return p.slice(("/"+loc).length)}return p}function same(h){try{return new URL(h,window.location.href).origin===window.location.origin}catch(x){return false}}function l(){var n=new URLSearchParams(window.location.search),e=n.get("return");if(!e||e.charAt(0)!=="/"||e.indexOf("//")===0)return;var b=bare(e),r=(n.get("has")||"").split(",").filter(Boolean);document.querySelectorAll("[data-language-link]").forEach(function(s){var t=s.getAttribute("data-locale");if(!t)return;var a=r.length&&r.indexOf(t)<0?"/":b,o=a;t!==DEF&&(o=a==="/"?"/"+t+"/":"/"+t+a);same(o)&&s.setAttribute("href",o)})}l();document.addEventListener("astro:page-load",l)})();`}></script>
</SiteLayout>
