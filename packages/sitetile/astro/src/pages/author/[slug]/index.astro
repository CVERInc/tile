---
// REEF with Blog — WordPress author archive at /author/<slug>/, PAGE 1 (pages 2+ at
// /author/<slug>/page/<n>). WP publishes every author at /author/<nicename>/ and links it from
// each post's byline; those URLs must survive cutover. One page per DISTINCT author slug in the
// corpus (post.author). Heading uses the display name from `blog-author-names: slug=名稱 | …`
// (else the slug). OPT-IN via `blog-author-routes`.
import ArchiveView from '../../../components/ArchiveView.astro';
import { allPosts, listedPosts, siteMeta, kvMap, archivePrefixes } from '../../../lib/blog.mjs';

export function getStaticPaths() {
  const allPostsIn = allPosts(
    import.meta.glob('../../../../blog/*.md', { query: '?raw', import: 'default', eager: true })
  );
  const meta = siteMeta(
    import.meta.glob('../../../../content/*.md', { query: '?raw', import: 'default', eager: true })
  );
  // Unlisted posts are absent from this archive AND from the set of archives that exist at
  // all: a term every one of whose posts is unlisted gets no route, so nothing can link to an
  // empty one. The posts themselves keep their own URLs — see listedPosts in lib/blog.mjs.
  const posts = listedPosts(allPostsIn, meta);
  const on = meta['blog-author-routes'] != null && String(meta['blog-author-routes']) !== 'false';
  if (!on) return [];
  const seen = new Set();
  const authors = [];
  for (const p of posts) if (p.author && !seen.has(p.author)) { seen.add(p.author); authors.push(p.author); }
  return authors.map((slug) => ({ params: { slug }, props: { posts, meta, slug } }));
}

const { posts, meta, slug } = Astro.props;
const base = String(meta['blog-author-base'] || '/author').replace(/\/$/, '');
const names = kvMap(meta['blog-author-names']);
const heading = names[slug] || slug;
const authorPosts = posts.filter((p) => p.author === slug);
const subhead = archivePrefixes(meta).author + heading;
const pageHref = (n) => (n === 1 ? `${base}/${slug}` : `${base}/${slug}/page/${n}`);
---
<ArchiveView posts={authorPosts} corpus={posts} meta={meta} title={`${heading} — ${meta.title || ''}`}
  heading={heading} subhead={subhead} pageHref={pageHref} pageNum={1} />
