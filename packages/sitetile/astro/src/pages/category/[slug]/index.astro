---
// REEF with Blog — WordPress category archive at /category/<slug>/, PAGE 1 (pages 2+ at
// /category/<slug>/page/<n>). WP publishes every category at /category/<slug>/ (slug, not name)
// and links them from post meta + category widgets; those URLs must survive cutover. One page per
// DISTINCT category slug present in the corpus (post.categories). Heading uses the display name
// from `blog-category-names: slug=名稱 | …` (else the slug). OPT-IN via `blog-category-routes`.
//
// Lingo sibling: pages/[...loc]/category/[slug]/index.astro emits the SAME slug set for each
// translated locale that routes it. `alternates` below is that reciprocal hreflang — computed by
// termLocaleMap so this file and its sibling can never advertise a locale the other side doesn't
// also route (see lib/blog.mjs's header on localizeArchiveHref/alternateArchiveLocales for why).
import ArchiveView from '../../../components/ArchiveView.astro';
import { allPosts, listedPosts, siteMeta, kvMap, archivePrefixes, termLocaleMap, alternateArchiveLocales } from '../../../lib/blog.mjs';

export function getStaticPaths() {
  const contentFiles = import.meta.glob('../../../../content/**/*.md', { query: '?raw', import: 'default', eager: true });
  const allPostsIn = allPosts(
    import.meta.glob('../../../../blog/*.md', { query: '?raw', import: 'default', eager: true })
  );
  const meta = siteMeta(
    import.meta.glob('../../../../content/*.md', { query: '?raw', import: 'default', eager: true })
  );
  // Unlisted posts are absent from this archive AND from the set of archives that exist at
  // all: a term every one of whose posts is unlisted gets no route, so nothing can link to an
  // empty one. The posts themselves keep their own URLs — see listedPosts in lib/blog.mjs.
  const posts = listedPosts(allPostsIn, meta);
  const on = meta['blog-category-routes'] != null && String(meta['blog-category-routes']) !== 'false';
  if (!on) return [];
  const seen = new Set();
  const cats = [];
  for (const p of posts) for (const c of (p.categories || [])) if (c && !seen.has(c)) { seen.add(c); cats.push(c); }
  const localeBlogFiles = import.meta.glob('../../../../blog/*/*.md', { query: '?raw', import: 'default', eager: true });
  const { mapByUrl, urlToLocale } = termLocaleMap('category', contentFiles, localeBlogFiles, meta, allPostsIn, posts);
  return cats.map((slug) => ({
    params: { slug },
    props: { posts, meta, slug, alternates: alternateArchiveLocales(mapByUrl, slug, urlToLocale) },
  }));
}

const { posts, meta, slug, alternates } = Astro.props;
const base = String(meta['blog-category-base'] || '/category').replace(/\/$/, '');
const names = kvMap(meta['blog-category-names']);
const heading = names[slug] || slug;
const catPosts = posts.filter((p) => (p.categories || []).includes(slug));
const subhead = archivePrefixes(meta).category + heading;
const pageHref = (n) => (n === 1 ? `${base}/${slug}` : `${base}/${slug}/page/${n}`);
---
<ArchiveView posts={catPosts} corpus={posts} meta={meta} title={`${heading} — ${meta.title || ''}`}
  heading={heading} subhead={subhead} pageHref={pageHref} pageNum={1} alternates={alternates} />
